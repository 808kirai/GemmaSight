# copy this file to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemma 4 model on the gemini api, gemma-4-31b-it is slower but stronger
GEMMASIGHT_MODEL=gemma-4-26b-a4b-it

# set to ollama to run an open weight gemma model locally instead
GEMMASIGHT_BACKEND=gemini
OLLAMA_HOST=http://localhost:11434
GEMMASIGHT_OLLAMA_MODEL=gemma4
